# Fast path toggle: "1" = fast one-shot RAG; any other/missing value = agentic.
IS_FAST_RAG=

# LLM provider: openai | anthropic | deepseek | ollama.
# Unset: fast path defaults to ollama, agentic path defaults to openai.
LLM_PROVIDER=

# Cloud credentials (used when provider is openai/anthropic/deepseek).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# DeepSeek (OpenAI-compatible API; supports tool calling).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local Ollama (any locally installed model, e.g. llama3.2 or qwen2.5-coder).
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# GitHub access.
GITHUB_TOKEN=
# Optional: auto-load a previously ingested user's index on startup.
GITHUB_USERNAME=

# Embeddings and index.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_DIR=./data/faiss

# LangSmith tracing.
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ask-my-github
LANGCHAIN_ENDPOINT=
