# Fast path toggle: "1" = fast one-shot RAG; any other/missing value = agentic
IS_FAST_RAG=0

# LLM provider: openai | anthropic | deepseek | ollama
LLM_PROVIDER=ollama

# Cloud credentials (used when provider is openai/anthropic/deepseek)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local Ollama — any locally installed model works for the fast path; the agentic path needs tool-calling support
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_BASE_URL=http://localhost:11434

# GitHub API access
GITHUB_TOKEN=
# Optional: auto-load a previously ingested user's index on startup so query endpoint is ready to use immediately
GITHUB_USERNAME=

# Embeddings: provider = fastembed (local, ONNX) | openai (cloud)
# - fastembed: EMBEDDING_MODEL is an ONNX-optimized model, runs on your machine
# - openai: EMBEDDING_MODEL e.g. text-embedding-3-small, uses OPENAI_API_KEY
EMBEDDING_PROVIDER=openai #fastembed
EMBEDDING_MODEL=text-embedding-3-small #jinaai/jina-embeddings-v2-base-code
FAISS_DIR=./.data/faiss

# How many chunks to retrieve per query before grading
RETRIEVER_K=15

# LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ask-my-github
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com # for EU users, otherwise use: https://api.smith.langchain.com

# Logging
LOG_DIR=./.logs
LOG_FILE=app.log
LOG_LEVEL=INFO
